# Application
APP_URL=http://localhost:3000
NODE_ENV=development

# Database / infrastructure
DATABASE_URL=postgresql://magazala:magazala@localhost:5432/magazala
REDIS_URL=redis://localhost:6379

# Authentication / encrypted provider credentials
SESSION_SECRET=replace-with-at-least-32-random-characters
# Exactly 32 random bytes encoded as base64. Never commit the real key.
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-32-byte-base64-key

# Private S3-compatible object storage (MinIO in local development)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=magazala
S3_ACCESS_KEY=minio
S3_SECRET_KEY=change-me
S3_FORCE_PATH_STYLE=true

# Product Intelligence Research Mode
# Self-hosted/approved SearXNG base URL. Leave empty to disable source-backed research.
SEARXNG_BASE_URL=

# AI provider API keys are NOT configured here.
# Add and rotate provider credentials from Admin > API Sağlayıcıları.
# They are encrypted at rest with CREDENTIAL_ENCRYPTION_KEY and are never sent to the browser.
