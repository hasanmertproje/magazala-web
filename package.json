{
  "name": "magazala",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@10",
  "scripts": {
    "dev": "npm run dev --workspace=@tasarlayalim/web",
    "build": "npm run build --workspace=@tasarlayalim/web",
    "typecheck:core": "tsc -p packages/core/tsconfig.json --noEmit",
    "build:core": "bash scripts/build-core.sh",
    "test:core": "npm run build:core && node --test packages/core-tests/core.test.mjs",
    "check": "npm run typecheck:core && npm run test:core"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
