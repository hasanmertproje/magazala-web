{
  "name": "magazala-web",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@10",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@magazala/web",
    "start": "npm run start --workspace=@magazala/web",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema=prisma/schema.prisma",
    "typecheck:core": "tsc -p packages/core/tsconfig.json --noEmit",
    "typecheck:web": "npm run prisma:generate && npm run typecheck --workspace=@magazala/web",
    "build:core": "bash scripts/build-core.sh",
    "test:core": "npm run build:core && node --test packages/core-tests/core.test.mjs",
    "policy:production-text": "node scripts/production-text-policy.mjs",
    "preflight:production": "node scripts/production-preflight.mjs",
    "check": "npm run policy:production-text && npm run typecheck:core && npm run test:core && npm run typecheck:web && npm run test:security",
    "build": "npm run prisma:generate && npm run build --workspace=@magazala/web",
    "test:security": "node --test tests/request-security.test.mjs"
  },
  "devDependencies": {
    "prisma": "6.19.3",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  }
}
